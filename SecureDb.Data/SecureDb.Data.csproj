<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SecureDb.Data</RootNamespace>
    <AssemblyName>SecureDb.Data</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SecureDb.Data</PackageId>
    <Version>1.0.0</Version>
    <Authors>Your Team</Authors>
    <Description>Database-agnostic transparent encryption wrapper (SecureDbConnection/SecureDbCommand/SecureDataReader) for any ADO.NET provider.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- No provider-specific package here on purpose — this project only depends on
       System.Data.Common, which ships with .NET itself. Whichever provider package
       (Microsoft.Data.SqlClient, Npgsql, MySqlConnector, etc.) you use lives in the
       APPLICATION project instead, since that's the only place that needs to know
       which real database you're connecting to. -->

  <ItemGroup>
    <ProjectReference Include="..\SecureDb.Core\SecureDb.Core.csproj" />
  </ItemGroup>

</Project>

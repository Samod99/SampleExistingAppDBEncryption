<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SecureDb.MigrationTool</RootNamespace>
    <AssemblyName>SecureDb.MigrationTool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swap for Npgsql / MySqlConnector if your existing app is on PostgreSQL/MySQL —
         same one-line change pattern as every other project in this solution. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureDb.Core\SecureDb.Core.csproj" />
  </ItemGroup>

</Project>

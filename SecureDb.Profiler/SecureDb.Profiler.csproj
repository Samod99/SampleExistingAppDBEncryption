<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SecureDb.Profiler</RootNamespace>
    <AssemblyName>SecureDb.Profiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only needed to CREATE the test connection to your SQL Server database. The
         discovery/classification code itself uses only System.Data.Common, same
         portability principle as SecureDb.Data. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureDb.Core\SecureDb.Core.csproj" />
  </ItemGroup>

</Project>
